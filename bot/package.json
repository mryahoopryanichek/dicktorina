{
  "name": "dicktorina-bot",
  "private": true,
  "description": "Telegram-бот записи на Dикторину: Cloudflare Workers + D1",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute dicktorina --local --file=schema.sql",
    "db:remote": "wrangler d1 execute dicktorina --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "setup": "node setup.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
